# DataGuardian repository hygiene
#
# Keep source, lockfiles, scripts, tests, and documentation tracked.
# Keep local dependencies, generated builds, secrets, caches, and binary
# artifacts out of Git.

# OS and filesystem metadata
.DS_Store
Thumbs.db
Desktop.ini
*:Zone.Identifier

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Logs and runtime scratch files
.logs/
logs/
*.log
*.pid
*.seed
*.tmp
tmp/
temp/

# Python: optional E2E tooling only
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node, npm, and Next.js frontend
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/next-env.d.ts
out/
frontend/out/
coverage/
frontend/coverage/
playwright-report/
frontend/playwright-report/
test-results/
frontend/test-results/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Go build and test artifacts
bin/
build/
dist/
*.test
*.out
*.prof
*.cover
coverage.out
vendor/

# Local databases and persisted dev state
*.db
*.sqlite
*.sqlite3
*.sql
postgres-data/
pgdata/

# Binary archives and generated distributables
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.gz
*.exe
*.dll
*.so
*.dylib
*.bin

# IDE and editor state
.idea/
.vscode/
*.swp
*.swo
*.bak
*~

# Legacy backend is reference-only and must not re-enter active runtime.
backend-legacy-python/

# Local AI/tooling state
.codex/
codex/
.agents/.codex
.codex
.agents
.logs
.venv
.env
