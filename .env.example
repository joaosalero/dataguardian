# DataGuardian local Docker defaults.
# Copy to .env only when you need to override these values.

APP_NAME=DataGuardian
ENVIRONMENT=dev

POSTGRES_USER=dataguardian
POSTGRES_PASSWORD=dataguardian
POSTGRES_DB=dataguardian
BACKEND_DATABASE_URL=postgresql://dataguardian:dataguardian@db:5432/dataguardian

GO_BACKEND_ADDR=0.0.0.0:8000
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=dataguardian_session
COOKIE_SAMESITE=lax
STORAGE_DIR=/data/uploads

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=dev
